# Checkmarx One tenant
CX_TENANT=your-tenant-name
CX_REGION=US2

# Auth: use API key OR OAuth client (not both required)
CX_API_KEY=
CX_CLIENT_ID=
CX_CLIENT_SECRET=

# Bulk scan tuning
CX_MAX_CONCURRENT=800
CX_SUBMIT_WORKERS=50
CX_SCAN_TAG=bulk-scan
# Optional: limit engines, e.g. sast or sast,kics
# CX_SCAN_ENGINES=sast

# Optional: override region hosts (US2 defaults shown below)
# CX_IAM_HOST=us.iam.checkmarx.net
# CX_API_HOST=us.ast.checkmarx.net
