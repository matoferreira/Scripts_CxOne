# Checkmarx One tenant (your organization name in IAM)
CHECKMARX_TENANT=your-tenant-name

# Regional AST API base URL (no trailing slash)
# US1 (testing):
#   CHECKMARX_BASE_URL=https://ast.checkmarx.net
#   CHECKMARX_AUTH_URL=https://iam.checkmarx.net
# US2 (client):
#   CHECKMARX_BASE_URL=https://us.ast.checkmarx.net
#   CHECKMARX_AUTH_URL=https://us.iam.checkmarx.net
CHECKMARX_BASE_URL=https://ast.checkmarx.net
CHECKMARX_AUTH_URL=https://iam.checkmarx.net

# API key generated in Checkmarx One > User Management > API Keys
# Docs: https://checkmarx.stoplight.io/docs/checkmarx-one-api-reference-guide/ybti0d5u0auto-authentication
CHECKMARX_API_KEY=

# Días máximos desde el último escaneo completado antes de recalcular
PRIORITY_1_DAYS=7
PRIORITY_2_DAYS=15
PRIORITY_3_DAYS=30

# Optional: path to the Excel file (defaults to pr_codigo.xlsx next to this script)
# PROJECTS_EXCEL=pr_codigo.xlsx

# Optional: directory for execution reports (defaults to ./reports)
# REPORT_DIR=reports
